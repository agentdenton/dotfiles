export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

export FZF_DEFAULT_COMMAND='rg --files --no-ignore-vcs --hidden'
export FZF_DEFAULT_OPTS="-m --height 50% \
--color=bg+:#414559,bg:-1,spinner:#f2d5cf,hl:#e78284 \
--color=fg:#c6d0f5,header:#e78284,info:#ca9ee6,pointer:#f2d5cf \
--color=marker:#f2d5cf,fg+:#c6d0f5,prompt:#ca9ee6,hl+:#e78284"

export EDITOR=hx
export VISUAL=hx

export EXA_STRICT=1
export BAT_THEME="Catppuccin Mocha"
export BAT_PAGER="less -R"
export MANROFFOPT=-c
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export DEBUGINFOD_URLS=""

alias lg='lazygit'
alias ld='lazydocker'
alias zed='zeditor'

alias clc='clear'
alias wy='wl-copy'

alias sctl='systemctl'
alias jctl='journalctl'

alias fd='fd --color=never'
alias rgc='rg --color=always'

alias rmf='rm -rf -I'

alias gc='git commit'
alias gs='git status'
alias grv='git remote -v'
alias gba='git branch -a'
alias gck='git checkout'
alias gl='git log'
alias glp='git log -p'
alias gl1='git log --oneline'
alias gbl='git blame'
alias grh='git reset --hard'
alias grs='git reset --soft'
alias gclc='git clean -fdx'

alias zedit='$EDITOR "$HOME/.zshrc"'
alias zsrc='source "$HOME/.zshrc"'

if command -v nvim >/dev/null 2>&1; then
  alias vi='nvim'
  alias vim='nvim'
fi

if command -v bat >/dev/null 2>&1; then
  alias cat='bat -p'
  alias bat='bat -p'
fi

if command -v eza >/dev/null 2>&1; then
  alias ls='eza -l'
  alias ll='eza -la --group-directories-first'
  alias lss='eza -la -s size'
  alias lld='eza -la -s date'
fi

if command -v zoxide >/dev/null 2>&1; then
  alias cd='z'
  alias cdi='zi'
  eval "$(zoxide init zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

f() {
  local file
  file="$(fd -t f | fzf)" || return
  if [[ -n "$file" ]]; then
    "$EDITOR" "$file"
  fi
}

y() {
  local tmp cwd
  tmp="$(mktemp -t 'yazi-cwd.XXXXXX')" || return
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r cwd <"$tmp"
  if [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

cdf() {
  local dir
  dir="$(fd -I -t d | fzf)" || return
  if [[ -n "$dir" ]]; then
    builtin cd -- "$dir" || return
  fi
}

if [[ -o interactive ]]; then
  bindkey -v
  bindkey -s '^F' 'f\n'
  bindkey -s '^Y' 'y\n'
fi
